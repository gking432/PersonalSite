{
  "name": "gunnar-neuman-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/list-pdfs.js && node scripts/fetch-substack.mjs && vite",
    "build": "node scripts/list-pdfs.js && node scripts/fetch-substack.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist/server --emptyOutDir false && node scripts/prerender.mjs",
    "preview": "vite preview",
    "compress-images": "node scripts/compress-images.js",
    "compress-images:dry": "node scripts/compress-images.js --dry-run",
    "game:dev": "npm --prefix games/milwaukee-traffic run dev",
    "game:build": "npm --prefix games/milwaukee-traffic run build",
    "game:test": "npm --prefix games/milwaukee-traffic test",
    "milwaukee:dev": "vite --config previews/little-milwaukee/vite.config.mjs",
    "milwaukee:build": "vite build --config previews/little-milwaukee/vite.config.mjs",
    "test:traffic": "node --test tests/trafficHomepage.test.mjs tests/pedestrianEscape.test.mjs tests/milwaukeeLandmarks.test.mjs tests/worldConditions.test.mjs tests/marblePhysics.test.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "playwright": "^1.58.2",
    "puppeteer-core": "^24.38.0",
    "sharp": "^0.33.0",
    "vite": "^5.0.8"
  }
}
